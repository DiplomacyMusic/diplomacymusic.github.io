---
import fs from 'node:fs';
import Site from '../layouts/Site.astro';
import Company from '../components/Company.astro';
import DemoPlayer from '../components/DemoPlayer.astro';
import credits from '../data/credits.json';
import games from '../data/games.json';
import reels from '../data/reels.json';
import demos from '../data/demos.json';
import site from '../data/site.json';

// small web copies made by tools/make_thumbs.sh
const thumb = (path) =>
  path ? path.replace('/art/', '/art/thumb/').replace(/\.(jpg|png|webp)$/, '.webp') : null;

// what each credit answers to in the filter row
const tagsFor = (credit) => {
  const tags = new Set();
  for (const role of credit.roles) {
    if (/Composer/.test(role)) tags.add('score');
    if (/Sound Designer/.test(role)) tags.add('design');
    if (/Mix/.test(role)) tags.add('mix');
    if (/Supervisor/.test(role)) tags.add('supervision');
  }
  return [...tags];
};

const filters = [
  { id: 'all', label: 'Everything' },
  { id: 'score', label: 'Score' },
  { id: 'design', label: 'Sound design' },
  { id: 'mix', label: 'Mix' },
  { id: 'supervision', label: 'Supervision' },
];

// Eight shows lead the grid, in this order. The rest follow in the order of
// the credits file, newest first.
const leadWork = [
  'dc-batman',
  'patel-motel',
  'quiet-part-loud',
  'wastelanders-black-widow',
  'case-63-s1',
  'summer-oath',
  'star-trek-khan',
  'hit-singles',
];
const leadRank = (credit) => (leadWork.includes(credit.id) ? leadWork.indexOf(credit.id) : leadWork.length);
const work = credits
  .map((credit, i) => ({ ...credit, tags: tagsFor(credit), thumb: thumb(credit.artwork), i }))
  .sort((x, y) => leadRank(x) - leadRank(y) || x.i - y.i);

// recognition, counted straight from the credits so it can never drift
// Every season is its own credit and counts on its own. Seasons of one
// show sit together, in order.
const showKey = (credit) => credit.group || credit.id;
const showsWith = (badge) => {
  const hits = credits.filter((credit) => credit.badges.includes(badge));
  const firstSeen = (credit) => hits.findIndex((other) => showKey(other) === showKey(credit));
  return hits
    .map((credit, i) => ({ credit, i }))
    .sort((x, y) => firstSeen(x.credit) - firstSeen(y.credit) || x.credit.title.localeCompare(y.credit.title) || x.i - y.i)
    .map(({ credit }) => credit.title);
};
const appleFiction = showsWith('Apple Fiction #1');
const spotifyGlobal = showsWith('Spotify Global #1');
// a platform's own app mark sits on the line with its figure, in the
// figure's tone. A mark shows only once its file is in public/brand/logos.
const platformMark = (file: string, name: string) =>
  fs.existsSync(`public/brand/logos/${file}`) ? { src: `/brand/logos/${file}`, name } : undefined;
// Signal and Ambie wins and nominations, counted from the award lines in
// the credits: "Signal Award Winner: a, b", "Ambies: a, Winner", or
// "Ambie nominations: a, b".
const tally = (name: string, extraNoms = 0) => {
  let wins = 0;
  let noms = extraNoms;
  for (const credit of credits) {
    for (const award of credit.awards || []) {
      const [head, rest = ''] = award.split(':');
      if (!head.includes(name)) continue;
      const items = rest.split(',').map((item) => item.trim()).filter(Boolean);
      // a Signal Gold is a win; Silver and Bronze count as nominations
      if (/nomination|silver|bronze/i.test(head)) noms += items.length;
      else if (/winner|gold/i.test(head)) wins += items.length;
      else if (items.at(-1) === 'Winner') wins += items.length - 1;
    }
  }
  const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const parts = [count(wins, 'win', 'wins'), noms ? count(noms, 'nom', 'noms') : ''].filter(Boolean);
  return { parts, label: parts.join(' \u00b7 ') };
};
const recognition = [
  {
    figure: 'Grammy',
    label: 'Award winner',
    lines: ['The Poet Who Sat by the Door', 'J. Ivy', 'Best Spoken Word Poetry Album', 'Producer, \u201cVibrations II\u201d'],
  },
  {
    figure: 'Signal',
    label: tally('Signal').label,
    // a star marks a category that was won
    lines: [
      'DC High Volume: Batman',
      { text: 'Most Innovative Audio Experience', star: true },
      { text: 'Best Scripted Fiction', star: true },
    ],
    // the Ambies and the Webbys ride along here, side by side
    also: [
      { name: 'Ambies', parts: tally('Ambie').parts },
      // one more nomination than the credits hold: Finding Dolores, 2019, in the ledger below
      { name: 'Webby', parts: tally('Webby', 1).parts },
    ],
  },
  {
    figure: String(appleFiction.length),
    label: 'Apple Fiction No.\u00a01',
    lines: appleFiction,
    mark: platformMark('apple-podcasts-icon.svg', 'Apple Podcasts'),
  },
  {
    figure: String(spotifyGlobal.length),
    label: 'Spotify Global No.\u00a01',
    lines: spotifyGlobal,
    mark: platformMark('spotify-icon.svg', 'Spotify'),
  },
  // The Ambie card is parked, not gone: take `parked` away to bring it back.
  {
    parked: true,
    figure: 'Ambie',
    label: tally('Ambie').label,
    lines: [
      'Murder at the Patel Motel',
      'Winner, Best Performance in Audio Fiction',
      'Nominated, Best Original Score and Music Supervision',
    ],
  },
].filter((card) => !card.parked);

const titles = games.map((game) => ({ ...game, thumb: thumb(game.artwork) }));
const licenses = [...new Set(games.map((game) => game.license).filter(Boolean))];
const FIRST_GAMES = 15;

// the symbols that fly past while the reels spin: art from further down the list
const reelPool = titles.slice(FIRST_GAMES).filter((game) => game.thumb).slice(0, 14).map((game) => game.thumb);

// A field of soft lights behind the games: out of focus glints, placed by a
// fixed seed so the page builds the same way every time.
const seeded = (seed) => () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const rand = seeded(1048576);
const LIGHTS = ['#e9c98d', '#f4ead2', '#d9d7c2', '#a9bcc0', '#e6a98f'];
const bokeh = Array.from({ length: 22 }, (_, i) => {
  const size = 3 + rand() * 9;
  return {
    left: (rand() * 104 - 2).toFixed(1),
    top: (rand() * 100).toFixed(1),
    size: size.toFixed(1),
    color: LIGHTS[Math.floor(rand() * LIGHTS.length)],
    glow: (0.1 + rand() * 0.22).toFixed(2),
    blur: (size * 0.14).toFixed(1),
    depth: (rand() * 1.1 - 0.35).toFixed(2),
    time: (5 + rand() * 7).toFixed(1),
    delay: (-rand() * 10).toFixed(1),
  };
});
const glints = Array.from({ length: 34 }, () => ({
  left: (rand() * 100).toFixed(1),
  top: (rand() * 100).toFixed(1),
  size: (1.5 + rand() * 2.5).toFixed(1),
  time: (1.8 + rand() * 3.4).toFixed(1),
  delay: (-rand() * 6).toFixed(1),
}));

const statement = 'A sound studio for stories, games, and immersive audio.';

// Daniel's own words, from the old site. They write themselves out in the
// contact band as the page scrolls.
const note =
  "I'm just like you, I have been making sounds my whole life. The only difference is that I record them, combine them, and put them back out into the world.";

const pillars = [
  {
    word: 'Music',
    text: 'Original score for audio drama, games, and picture.',
  },
  {
    word: 'Sound',
    text: 'Sound design, re-recording mix, and post production supervision.',
  },
  {
    word: 'Lab',
    text: 'Innovating new tools to optimize creativity and get out of the way.',
  },
];

const earlier = [
  {
    term: 'Advertising',
    lines: [
      "Music for Kellogg's, McDonald's, Maytag, Whirlpool, Secret, Centrum, Mack Trucks, the Beef Council, and Exelon.",
      'With Leo Burnett, BBDO, VSA Partners, Draft FCB, and Razorfish.',
    ],
  },
  {
    term: 'Records',
    lines: [
      'Gemini Club, MONAKR, and Shealeigh.',
      'No. 1 rotation on SiriusXM Alt Nation. No. 3 on Radio Disney. Lollapalooza, 2014.',
    ],
  },
  {
    term: 'Sync',
    lines: ['Nintendo 3DS, Ubisoft Watch Dogs, TNT, Vice, Gatorade, Hugo Boss, MTV, Red Bull, Lacoste, Fox Sports Net.'],
  },
  {
    term: 'Film',
    lines: ['Feature scores for Broken Bridge, The North Star, Greensburg (PBS), and Poverty in Chicago (PBS).'],
  },
  {
    term: 'Interactive',
    lines: ['Finding Dolores, a voice guided interactive podcast. Webby nominee, 2019.'],
  },
];

const creditData = Object.fromEntries(
  work.map((credit) => [
    credit.id,
    {
      title: credit.title,
      publisher: credit.publisher,
      producers: credit.producers,
      roles: credit.roles,
      genre: credit.genre,
      stars: credit.stars,
      highlights: credit.highlights || [],
      badges: credit.badges,
      awards: credit.awards,
      links: credit.links,
      thumb: credit.thumb,
    },
  ])
);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://diplomacymusic.com/#diplomacy',
      name: 'Diplomacy',
      alternateName: 'Diplomacy Music',
      url: 'https://diplomacymusic.com/',
      logo: 'https://diplomacymusic.com/brand/diplomacy-avatar.jpg',
      image: 'https://diplomacymusic.com/og.jpg',
      description: statement,
      email: site.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
      founder: { '@id': 'https://diplomacymusic.com/#daniel-brunelle' },
      sameAs: site.socials.filter((s) => s.label === 'Facebook').map((s) => s.href),
    },
    {
      '@type': 'Person',
      '@id': 'https://diplomacymusic.com/#daniel-brunelle',
      name: 'Daniel Brunelle',
      jobTitle: 'Composer and Sound Designer',
      url: 'https://diplomacymusic.com/#studio',
      worksFor: { '@id': 'https://diplomacymusic.com/#diplomacy' },
      sameAs: site.socials.filter((s) => s.label !== 'Facebook').map((s) => s.href),
    },
    {
      '@type': 'WebSite',
      name: 'Diplomacy Music',
      url: 'https://diplomacymusic.com/',
      publisher: { '@id': 'https://diplomacymusic.com/#diplomacy' },
    },
  ],
};
---

<Site
  title="Diplomacy Music | Score and Sound Design for Stories and Games"
  description="Diplomacy is the sound studio of composer and sound designer Daniel Brunelle. Score, sound design, and mix for audio drama, games, and immersive audio. Chicago."
>
  <!-- The stage: the one lake video, fixed behind the top of the page. It
       drifts slower than the scroll and falls out of focus as the page
       moves. It is seen through two windows: the hero, which lightens to
       paper as it leaves, and the recognition band, which shows it dimmed.
       After that band it rests. The lab at the foot of the page shows the
       same lake as a still frame, not the moving video. -->
  <div class="stage" aria-hidden="true">
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      poster={site.hero.poster}
      data-hd={site.hero.video.hd}
      data-sd={site.hero.video.sd}></video>
    <div class="stage-tint"></div>
  </div>

  <section class="hero" id="top">

    <!-- the wordmark and the line rest dead center, then ride the scroll a little slower than the page -->
    <div class="hero-copy">
      <h1 class="visually-hidden">Diplomacy. {statement}</h1>
      <span class="brand-mask hero-wordmark" role="img" aria-label="Diplomacy"></span>
      <p class="hero-tag">Sound is listening</p>
      <!-- the studio's theme: a glass button under the line. It rides with the
           wordmark, so it keeps the wordmark's place and pace -->
      <button class="track-button hero-play" id="track-play" type="button" aria-label="Play the studio theme" aria-pressed="false">
        <span class="track-glyph" aria-hidden="true"></span>
      </button>
    </div>

    <a class="hero-cue" href="#statement" aria-label="Scroll to the work"><span></span></a>
  </section>

  <!-- The volume line comes on once the theme plays. It drifts up slower than
       the page until it sits level with the studio's line, and from there it
       travels with that line. The small button in the corner takes over when
       the hero's own button has left the screen. -->
  <div class="track-volume" id="track-volume" hidden>
    <span class="track-volume-line" aria-hidden="true"><span class="track-volume-dot"></span></span>
    <label class="visually-hidden" for="track-level">Volume</label>
    <input class="visually-hidden" type="range" id="track-level" min="0" max="1" step="0.01" value="0.6" />
  </div>
  <button class="track-button track-corner" id="track-corner" type="button" aria-label="Pause the studio theme" aria-pressed="true" hidden>
    <span class="track-glyph" aria-hidden="true"></span>
  </button>

  <main class="sheet">
    <!-- statement -->
    <section class="band band-statement" id="statement">
      <div class="band-inner">
        <p class="overline" data-reveal>Diplomacy</p>
        <p class="statement" data-words>
          {statement.split(' ').map((w) => <><span class="w">{w}</span>{' '}</>)}
        </p>
        <div class="pillars">
          {pillars.map((pillar) => (
            <div class="pillar" data-reveal>
              <h2>{pillar.word}</h2>
              <p>{pillar.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="band band-company" aria-label="Publishers and studios Diplomacy has worked with">
      <div class="band-inner">
        <Company />
      </div>
    </section>

    <!-- recognition -->
    <section class="band band-recognition deep" aria-label="Recognition">
      <!-- this band is a dim window onto the stage: the one lake video, by now far out of focus -->
      <div class="band-inner" data-depth="0.07">
        <p class="overline" data-reveal>Recognition</p>
      </div>
      <!-- the cards ease in one after another, left to right and top to bottom,
           the same quiet rise as the ledger rows further down. The whole block
           rides a little faster than the band, so it floats over the lake -->
      <div class="band-inner facts" id="facts" data-depth="0.07">
        {recognition.map((fact, i) => (
          <div class="fact" style={`--i: ${i}`} data-reveal data-reveal-step="120">
            <span class="fact-head">
              <span class="fact-figure" data-count={/^\d+$/.test(fact.figure) ? fact.figure : undefined}>{fact.figure}</span>
              {fact.mark && (
                <span class="brand-mask fact-mark" role="img" aria-label={fact.mark.name} style={`--brand-asset: url('${fact.mark.src}')`}></span>
              )}
            </span>
            <span class="fact-label">{fact.label}</span>
            <span class="fact-detail">
              {fact.lines.map((line, j) => (
                <span style={`--j: ${j}`}>
                  {typeof line === 'string' ? line : <>{line.star && <span class="fact-star" aria-label="Winner">{'\u2605'}</span>}{line.text}</>}
                </span>
              ))}
            </span>
            {fact.also && (
              <span class="fact-also">
                {fact.also.map((award) => (
                  <span class="fact-also-item">
                    <span class="fact-label">{award.name}</span>
                    {award.parts.map((part) => <span class="fact-also-part">{part}</span>)}
                  </span>
                ))}
              </span>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- work -->
    <section class="band band-work" id="work">
      <div class="ghost-clip" aria-hidden="true">
        <span class="ghost" data-depth="-0.9" data-axis="x">Sound</span>
      </div>
      <div class="band-inner">
        <header class="section-head">
          <p class="overline" data-reveal>Audio drama</p>
          <h2 data-reveal>Stories, <span class="tone">told in the dark.</span></h2>
          <p class="lede" data-reveal>Productions for Audible, Marvel, DC, Star Trek, Spotify, and Sega, and like a hundred others.</p>
        </header>

        <div class="filters" role="group" aria-label="Filter the work by discipline">
          {filters.map((filter) => (
            <button class="chip" type="button" data-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'}>
              {filter.label}
            </button>
          ))}
        </div>

        <div class="covers" id="covers" data-depth-cols="0.07,-0.05,0.1,-0.02">
          {work.map((credit, i) => (
            <button
              class={`cover${i >= Math.ceil(work.length / 2) ? ' cover-extra' : ''}`}
              type="button"
              data-id={credit.id}
              data-tags={credit.tags.join(' ')}
              style={`view-transition-name: c-${credit.id}`}
              data-reveal
            >
              <span class="cover-art">
                <img src={credit.thumb} alt={`Cover art for ${credit.title}`} loading="lazy" width="640" height="640" />
                {credit.badges.length > 0 && <span class="cover-badge">{credit.badges[0]}</span>}
              </span>
              <span class="cover-title">{credit.title}</span>
              <span class="cover-role">{credit.roles.join(', ')}</span>
            </button>
          ))}
        </div>
        <!-- on a phone the second half waits behind More titles -->
        <div class="covers-more">
          <button class="line-button" type="button" id="covers-toggle" aria-controls="covers" aria-expanded="false">More titles</button>
          <a class="line-button" href={site.socials.find((s) => s.label === 'IMDb')?.href} target="_blank" rel="noopener">Full credits</a>
        </div>
      </div>
    </section>

    <!-- games -->
    <section class="band band-games dark" id="games">
      <!-- implied glitz: soft out of focus lights and a few glints -->
      <div class="bokeh" aria-hidden="true">
        {bokeh.map((light) => (
          <span
            class="bokeh-light"
            data-depth={light.depth}
            style={`left:${light.left}%; top:${light.top}%; width:${light.size}rem; --light:${light.color}; --glow:${light.glow}; --soft:${light.blur}rem; --time:${light.time}s; --delay:${light.delay}s`}
          />
        ))}
        {glints.map((glint) => (
          <span
            class="bokeh-glint"
            style={`left:${glint.left}%; top:${glint.top}%; width:${glint.size}px; --time:${glint.time}s; --delay:${glint.delay}s`}
          />
        ))}
      </div>
      <div class="ghost-clip" aria-hidden="true">
        <span class="ghost" data-depth="0.9" data-axis="x">Play</span>
      </div>
      <div class="band-inner">
        <header class="section-head">
          <p class="overline" data-reveal>Games</p>
          <h2 data-reveal>Where sound <span class="tone">meets code.</span></h2>
          <p class="lede" data-reveal>
            Dynamic music and audio experiences that go wherever the player goes.
          </p>
          <p class="games-facts" data-reveal>Over one hundred titles, built in FMOD, shipped in Unity.</p>
        </header>

        <!-- Fifteen titles show at a time, and they arrive as reels: every column
             spins, then they stop left to right. The Re-Spin button, on the right
             where the button lives on the real thing, deals another fifteen. Without scripts the whole list simply shows. -->
        <div class="games" id="games-grid" data-reel-pool={JSON.stringify(reelPool)}>
          {titles.map((game, i) => (
            <article class={`game${i < FIRST_GAMES ? ' is-on' : ''}`}>
              <span class={`game-art${game.thumb ? '' : ' game-art-name'}`}>
                {game.thumb ? (
                  <img src={game.thumb} alt={`Art for ${game.title}`} loading={i < FIRST_GAMES ? 'eager' : 'lazy'} width="720" height="450" />
                ) : (
                  <span aria-hidden="true">{game.title}</span>
                )}
              </span>
              <h3>{game.title}</h3>
              <p>{[game.license && game.license !== game.title ? game.license : null, game.year].filter(Boolean).join(' · ')}</p>
            </article>
          ))}
        </div>
        <p class="games-more">
          <button class="spin-button" type="button" id="games-spin"><span>Re-Spin</span></button>
        </p>
      </div>
      <div class="ghost-clip marquee-clip" aria-hidden="true">
        <span class="marquee" data-depth="-1.4" data-axis="x">{licenses.join('  ·  ')}  ·  {licenses.join('  ·  ')}</span>
      </div>
    </section>

    <!-- listen -->
    <section class="band band-listen" id="listen">
      <div class="ghost-clip" aria-hidden="true">
        <span class="ghost" data-depth="-0.9" data-axis="x">Music</span>
      </div>
      <div class="band-inner">
        <header class="section-head">
          <p class="overline" data-reveal>Listen</p>
          <h2 data-reveal>Reels <span class="tone">and records.</span></h2>
          <p class="lede" data-reveal>Score, design, and the bands that came first.</p>
        </header>

        {demos.length > 0 && <DemoPlayer />}

        <!-- a phone shows the first half, then More reels, the same way the
             audio drama covers do -->
        <div class="reels" id="reels">
          {reels.map((reel, i) => (
            <figure class={`reel${i === 0 ? ' reel-lead' : ''}${i >= Math.ceil(reels.length / 2) ? ' reel-extra' : ''}`} data-reveal>
              <button class="reel-frame" type="button" data-video={reel.id} aria-label={`Play ${reel.title}`}>
                <img
                  src={`https://i.ytimg.com/vi/${reel.id}/${reel.thumb}.jpg`}
                  alt=""
                  loading="lazy"
                  width="640"
                  height="360"
                />
                <span class="reel-play" aria-hidden="true"></span>
              </button>
              <figcaption>
                <span class="overline">{reel.kind}</span>
                <span class="reel-title">{reel.title}</span>
                <span class="reel-note">{reel.note}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="reels-more">
          <button class="line-button" type="button" id="reels-toggle" aria-controls="reels" aria-expanded="false">More reels</button>
        </div>
      </div>
    </section>

    <!-- a word from a client -->
    <section class="band band-quote" aria-label="Testimonial">
      <div class="band-inner">
        <blockquote data-reveal>
          <p data-words>
            {'Dan is the rare breed who possesses the instincts and hyper creativity of the most relevant artist-producers, but also understands the grind, nuance and collaboration required to appease all the subjective demands of making great music for marketing.'
              .split(' ')
              .map((w) => <><span class="w">{w}</span>{' '}</>)}
          </p>
          <footer>Chris Clark, Director of Music, Leo Burnett</footer>
        </blockquote>
      </div>
    </section>

    <!-- studio -->
    <section class="band band-studio" id="studio">
      <div class="ghost-clip" aria-hidden="true">
        <span class="ghost" data-depth="0.9" data-axis="x">Studio</span>
      </div>
      <div class="band-inner studio-grid">
        <div class="studio-copy">
          <p class="overline" data-reveal>Studio</p>
          <h2 data-reveal>Diplomacy <span class="tone">Studio</span></h2>
          <p data-reveal>
            Diplomacy is the studio of composer and sound designer Daniel Brunelle.
            Classical training, rock and roll energy, and a veteran in rooms where the
            deadline is real. Based in Chicago.
          </p>
          <p data-reveal>
            Daniel is Audio Manager and Advanced Sound Designer at Light &amp; Wonder and the
            founder of Diplomacy Music, LLC.
          </p>
        </div>
        <dl class="ledger">
          {earlier.map((row) => (
            <div class="ledger-row" data-reveal>
              <dt>{row.term}</dt>
              <dd>{row.lines.map((line) => <span>{line}</span>)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- contact -->
    <!-- Contact is a short scene. The band holds still while the page scrolls:
         once it is on screen the note writes itself out beside the portrait
         on a clock of its own, then the signature and the button arrive,
         and it stays finished. The scroll only decides when it starts.
         Without scripts or with reduced motion, everything simply shows. -->
    <section class="band band-contact sand" id="contact" aria-label="Contact">
      <div class="contact-scroll" id="contact-scroll">
        <div class="contact-stage">
          <div class="contact-copy">
            <span class="brand-mask contact-mark" role="img" aria-label="Diplomacy"></span>
            <p class="overline">Contact</p>
            <p class="contact-hello">Thanks for coming, i'm dan</p>
            <blockquote class="contact-note" aria-label={note}>
              <p class="typed" aria-hidden="true">
                {note.split(' ').map((word) => (
                  <><span class="tw-word">{[...word].map((ch) => <span class="tw-ch">{ch}</span>)}</span>{' '}</>
                ))}
              </p>
              <footer>Daniel Brunelle</footer>
            </blockquote>
          </div>

          <!-- the portrait is the backdrop of the scene: far bigger than the frame,
               and drifting slowly as the scroll moves the scene along -->
          <figure class="contact-portrait">
            <img src="/studio/portrait.webp" alt="Daniel Brunelle" width="994" height="1687" loading="lazy" />
          </figure>

          <div class="contact-cta">
            <a class="loud-button" href={`mailto:${site.email}?subject=${encodeURIComponent("Let's get loud together")}`}>
              <span>Let's get loud together.</span>
              <span class="loud-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <div class="contact-actions">
              <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
              <button class="line-button" type="button" id="copy-email" data-email={site.email}>Copy the address</button>
              <ul class="socials">
                {site.socials.map((social) => (
                  <li><a href={social.href} target="_blank" rel="noopener">{social.label}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- the lab: the explorable room, playable right here -->
  <section class="room" id="room" aria-label="The lab. A room of shapes you can play.">
    <div class="room-copy">
      <p class="overline" data-shade>The lab</p>
      <h2><span data-shade>Sound</span> <span class="tone" data-shade>is listening.</span></h2>
      <p class="room-hint" data-shade>Touch a shape. Throw one.<br />Make your wave[form]</p>
    </div>
    <!-- the one control, at the far end of the line that names the room -->
    <button class="line-button room-floor" type="button" id="room-floor" data-shade aria-pressed="false">Let them fall</button>
    <!-- on a phone, while the header is held down, the way back out -->
    <button class="line-button room-exit" type="button" id="room-exit" data-shade>Exit</button>
    <!-- the room, as it happens: every strike, swell, throw, and landing
         types a line here. It lies under the shapes and takes no touches. -->
    <div class="room-log" aria-hidden="true">
      <pre><code id="room-log"></code></pre>
    </div>
  </section>

  <dialog class="credit-dialog" id="credit-dialog" aria-labelledby="credit-title">
    <button class="dialog-close" type="button" aria-label="Close"></button>
    <div class="credit-body">
      <img id="credit-art" alt="" width="640" height="640" />
      <div class="credit-text">
        <p class="overline" id="credit-publisher"></p>
        <h2 id="credit-title"></h2>
        <p class="credit-roles" id="credit-roles"></p>
        <p class="credit-line" id="credit-stars"></p>
        <ul class="credit-awards" id="credit-awards"></ul>
        <p class="credit-links" id="credit-links"></p>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="credit-data" set:html={JSON.stringify(creditData)} />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Site>

<script>
  import { startMotion } from '../scripts/site-motion.js';
  import { sharedContext } from '../scripts/audio-context.js';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const saveData = (navigator as any).connection?.saveData === true;

  startMotion();

  // ---- hero and stage. One video, fixed behind the top of the page,
  // drifting slower than the scroll and falling out of focus as the page
  // moves. Two windows look onto it. The hero lightens to paper as it
  // leaves (--veil, which the phone layout also uses for its clear bands).
  // The recognition band shows it dimmed and far out of focus. Once that
  // band has gone by, the stage rests. The wordmark rests dead center,
  // then rides its own layer a little slower than the page.
  const hero = document.querySelector<HTMLElement>('.hero');
  const stage = document.querySelector<HTMLElement>('.stage');
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const heroCopy = document.querySelector<HTMLElement>('.hero-copy');
  const lastWindow = document.querySelector<HTMLElement>('.band-recognition');
  const canPlay = !reduced && !saveData;

  if (video && canPlay) {
    video.src = (window.innerWidth > 1000 ? video.dataset.hd : video.dataset.sd) || '';
    video.play().catch(() => {});
  }

  if (hero && stage && video && heroCopy && lastWindow) {
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const root = document.documentElement;
    const born = performance.now();
    let smooth = window.scrollY;
    let done = false;
    let lastBlur = -1;
    let lastVeil = -1;

    const frame = () => {
      const vh = window.innerHeight;
      smooth += (window.scrollY - smooth) * 0.16;
      const y = reduced ? window.scrollY : smooth;

      // the paper veil is complete as the recognition band enters the screen
      const band = lastWindow.getBoundingClientRect();
      const bandTop = band.top + window.scrollY;
      const end = Math.max(vh * 0.9, bandTop - vh);
      const ramp = vh * 0.45;
      const q = clamp01(y / ramp);
      const quick = q * q * (3 - 2 * q); // fast at first, eased
      const tail = clamp01((y - ramp) / Math.max(1, end - ramp));

      const veil = Math.round((quick * 0.8 + tail * 0.2) * 200) / 200;
      if (veil !== lastVeil) {
        lastVeil = veil;
        root.style.setProperty('--veil', String(veil));
      }

      const blur = Math.round((quick * 8 + tail * 2) * 2) / 2; // soft, so the lake still reads as a lake
      if (blur !== lastBlur) {
        lastBlur = blur;
        video.style.filter = blur > 0 ? `blur(${blur}px)` : 'none';
      }

      if (!reduced) {
        const drift = Math.min(y * 0.14, vh * 0.2);
        video.style.transform = `translate3d(0, ${(-drift).toFixed(1)}px, 0) scale(1.06)`;
        heroCopy.style.transform = `translate3d(0, ${(y * 0.2).toFixed(1)}px, 0)`;
      }

      const intro = reduced ? 1 : clamp01((performance.now() - born - 500) / 2600);
      const eased = 1 - Math.pow(1 - intro, 3);
      const away = clamp01(y / (hero.offsetHeight * 0.7));
      hero.style.setProperty('--focus', (eased * (1 - away)).toFixed(3));

      // once the last window has scrolled off the top, the stage rests
      const nowDone = band.bottom < -40;
      if (nowDone !== done) {
        done = nowDone;
        stage.classList.toggle('is-done', done);
        if (canPlay) {
          if (done) video.pause();
          else video.play().catch(() => {});
        }
      }

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  // ---- the live log over the room: lines typed out as they arrive
  const logNode = document.getElementById('room-log');
  if (logNode) {
    const MAX_LOG = 14;
    const buffer = ['// the room, as it happens'];
    const queue: string[] = [];
    let typing = false;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const render = () => (logNode.textContent = buffer.join('\n'));
    render();
    const drain = async () => {
      typing = true;
      while (queue.length) {
        const line = queue.shift() as string;
        buffer.push('');
        if (buffer.length > MAX_LOG) buffer.shift();
        // The hand speeds up with the backlog: one letter at a time when
        // the room is quiet, several at a time as lines pile up, and whole
        // lines at once in a storm, so the page keeps pace with the room.
        for (let at = 0; at < line.length; ) {
          const waiting = queue.length;
          const step = waiting > 5 ? line.length : 1 + waiting * 3;
          at = Math.min(line.length, at + step);
          buffer[buffer.length - 1] = line.slice(0, at);
          render();
          if (!reduced) await wait(waiting > 2 ? 4 : 11 - waiting * 3);
        }
      }
      typing = false;
    };
    window.addEventListener('diplomacy:log', (event) => {
      if (queue.length > 24) return; // a storm of events keeps only its leading edge
      queue.push((event as CustomEvent<string>).detail);
      if (!typing) drain();
    });
  }

  // ---- the studio theme. Nothing loads until the button is pressed. The
  // hero button and the corner button are one control in two places. The
  // volume line is placed by the scroll: slower than the page while it is
  // over the hero, then level with the studio's line and moving with it.
  const trackPlay = document.getElementById('track-play') as HTMLButtonElement | null;
  const trackCorner = document.getElementById('track-corner') as HTMLButtonElement | null;
  const trackVolume = document.getElementById('track-volume');
  const trackLevel = document.getElementById('track-level') as HTMLInputElement | null;
  const pitchLine = document.querySelector<HTMLElement>('.statement');
  if (trackPlay && trackCorner && trackVolume && trackLevel && hero && pitchLine) {
    let track: HTMLAudioElement | null = null;
    let started = false;
    let heroButtonSeen = true;

    const show = (playing: boolean) => {
      for (const button of [trackPlay, trackCorner]) {
        button.classList.toggle('is-playing', playing);
        button.setAttribute('aria-pressed', String(playing));
        button.setAttribute('aria-label', playing ? 'Pause the studio theme' : 'Play the studio theme');
      }
      trackVolume.hidden = !started;
      requestAnimationFrame(() => trackVolume.classList.toggle('is-on', started));
      trackCorner.hidden = !(started && !heroButtonSeen);
      placeVolume();
    };

    // The theme plays one of two ways. Most browsers stream it through an
    // audio element, whose volume the page can set. iPhones and iPads do
    // not let a page set that volume: there the theme is fetched and
    // decoded whole, and played through a gain stage by the same kind of
    // engine the lab uses, which is the one volume those devices obey.
    // Adding ?theme=buffer to the address picks the second way anywhere.
    const volumeSticks = (() => {
      const probe = new Audio();
      probe.volume = 0.5;
      return probe.volume === 0.5;
    })();
    const Ctx: typeof AudioContext | undefined = window.AudioContext || (window as any).webkitAudioContext;
    const appleTouch =
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.userAgent.includes('Macintosh') && navigator.maxTouchPoints > 1);
    const asked = new URLSearchParams(window.location.search).get('theme') === 'buffer';
    const decoded = !!Ctx && (!volumeSticks || appleTouch || asked);

    // What a phone's lock screen and a laptop's media keys call the sound
    // of this page. Without it they show only the site's address.
    if ('mediaSession' in navigator && 'MediaMetadata' in window) {
      navigator.mediaSession.metadata = new MediaMetadata({
        title: 'Daniel Brunelle',
        artist: 'Diplomacy',
        artwork: [{ src: '/apple-touch-icon.png', sizes: '180x180', type: 'image/png' }],
      });
    }

    // The decoded theme plays through the page's one shared audio engine,
    // the same one the lab uses, so the two can be heard together. It is
    // never paused by stopping that engine, which would silence the lab
    // too: pausing stops the theme's own source and remembers the place.
    let ctx: AudioContext | null = null;
    let gain: GainNode | null = null;
    let buffer: AudioBuffer | null = null;
    let source: AudioBufferSourceNode | null = null;
    let wanted = false; // what the visitor last asked for, playing or not
    let place = 0; // seconds into the piece, while it is not sounding
    let began = 0; // the engine's clock when the current source started

    const setLevel = (level: number) => {
      const v = Math.min(1, Math.max(0, level));
      trackLevel.value = String(v);
      trackVolume.style.setProperty('--level', v.toFixed(3));
      if (gain) gain.gain.value = v;
      else if (track) track.volume = v;
    };
    setLevel(Number(trackLevel.value));

    // The theme plays through once and stops. The next press starts it
    // again from the top.
    const startSource = () => {
      if (!ctx || !gain || !buffer) return;
      const node = ctx.createBufferSource();
      node.buffer = buffer;
      node.connect(gain);
      node.onended = () => {
        if (source !== node) return; // stopped on purpose, for a pause
        source = null;
        place = 0;
        wanted = false;
        show(false);
      };
      began = ctx.currentTime - place;
      node.start(0, place);
      source = node;
    };
    const holdSource = () => {
      if (!ctx || !source) return;
      place = Math.max(0, ctx.currentTime - began);
      const node = source;
      source = null; // so its ending is not mistaken for the end of the piece
      try {
        node.stop();
      } catch {
        // already stopped
      }
    };

    const toggleDecoded = async () => {
      started = true;
      // a phone call or a trip to another app stops the engine without
      // telling the page: the next press just starts it again
      if (ctx && source && wanted && ctx.state !== 'running') {
        ctx.resume().catch(() => {});
        return;
      }
      wanted = !wanted;
      show(wanted);
      if (ctx) {
        if (wanted) {
          ctx.resume().catch(() => {});
          if (buffer && !source) startSource();
        } else {
          holdSource();
        }
        return;
      }
      // first press: reach for the engine while the press still counts as one
      try {
        ctx = sharedContext();
        gain = ctx.createGain();
        gain.connect(ctx.destination);
        setLevel(Number(trackLevel.value));
        ctx.resume().catch(() => {});
        if (import.meta.env.DEV) (window as any).__theme = { ctx, gain, playing: () => source };
        const bytes = await (await fetch('/audio/site-theme.m4a')).arrayBuffer();
        const engineNow = ctx;
        buffer = await new Promise<AudioBuffer>((resolve, reject) => engineNow.decodeAudioData(bytes, resolve, reject));
        // pressed again while it was loading: it waits for the next press
        if (wanted) startSource();
      } catch {
        wanted = false;
        show(false);
        gain?.disconnect();
        ctx = null;
        gain = null;
        buffer = null;
      }
    };

    const toggleStreamed = () => {
      if (!track) {
        track = new Audio('/audio/site-theme.m4a');
        setLevel(Number(trackLevel.value));
        track.addEventListener('play', () => show(true));
        track.addEventListener('pause', () => show(false));
        track.addEventListener('ended', () => show(false));
      }
      started = true;
      if (track.paused) track.play().catch(() => show(false));
      else track.pause();
    };
    const toggle = decoded ? toggleDecoded : toggleStreamed;

    // The theme only plays while the site is in front. Leaving the tab,
    // the browser, or the app stops it at once; coming back picks it up
    // where it stopped. It never plays on behind anything else.
    let stoppedForAway = false;
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (decoded) {
          if (ctx && wanted && source) {
            stoppedForAway = true;
            holdSource();
          }
        } else if (track && !track.paused) {
          stoppedForAway = true;
          track.pause();
        }
      } else if (stoppedForAway) {
        stoppedForAway = false;
        if (decoded) {
          ctx?.resume().catch(() => {});
          if (wanted && buffer && !source) startSource();
        } else track?.play().catch(() => show(false));
      }
    });
    trackPlay.addEventListener('click', toggle);
    trackCorner.addEventListener('click', toggle);
    // the keyboard moves the hidden slider; a finger or the mouse drags the
    // line itself. The line claims the touch, so dragging it never scrolls.
    trackLevel.addEventListener('input', () => setLevel(Number(trackLevel.value)));
    const fromPointer = (event: PointerEvent) => {
      const box = trackVolume.getBoundingClientRect();
      const inset = 12; // the line stops short of the box at each end
      setLevel(1 - (event.clientY - box.top - inset) / Math.max(1, box.height - inset * 2));
    };
    let dragging = false;
    trackVolume.addEventListener('pointerdown', (event) => {
      dragging = true;
      fromPointer(event);
      event.preventDefault();
      try {
        trackVolume.setPointerCapture(event.pointerId); // keep the drag when the pointer leaves the line
      } catch {
        // no capture: the drag still works while the pointer stays over the line
      }
    });
    trackVolume.addEventListener('pointermove', (event) => {
      if (dragging) fromPointer(event);
    });
    const letGo = () => (dragging = false);
    trackVolume.addEventListener('pointerup', letGo);
    trackVolume.addEventListener('pointercancel', letGo);

    // the corner button stands in only while the hero's button is off screen
    new IntersectionObserver((entries) => {
      heroButtonSeen = entries[0].isIntersecting;
      trackCorner.hidden = !(started && !heroButtonSeen);
    }).observe(trackPlay);

    function placeVolume() {
      if (trackVolume!.hidden) return;
      const vh = window.innerHeight;
      const y = window.scrollY;
      const heroBox = hero!.getBoundingClientRect();
      const line = pitchLine!.getBoundingClientRect();
      const start = heroBox.top + y + heroBox.height * 0.6; // where it rests, on the page at the top
      const lineAt = line.top + y + line.height / 2; // the studio's line, on the page
      const lockView = vh * 0.35; // where on the screen the two meet
      const lockScroll = Math.max(1, lineAt - lockView);
      const at = y < lockScroll ? start + (lockView - start) * (y / lockScroll) : lineAt - y;
      trackVolume!.style.transform = `translate3d(0, ${(at - trackVolume!.offsetHeight / 2).toFixed(1)}px, 0)`;
      trackVolume!.classList.toggle('is-away', at < -120);
    }
    window.addEventListener('scroll', placeVolume, { passive: true });
    window.addEventListener('resize', placeVolume);
  }

  // ---- work: filter by discipline
  const covers = [...document.querySelectorAll<HTMLElement>('.cover')];
  const chips = [...document.querySelectorAll<HTMLElement>('.chip')];
  const count = document.getElementById('work-count');

  const applyFilter = (tag: string) => {
    let shown = 0;
    for (const cover of covers) {
      const match = tag === 'all' || (cover.dataset.tags || '').split(' ').includes(tag);
      cover.hidden = !match;
      if (match) {
        shown += 1;
        cover.classList.add('is-seen');
      }
    }
    if (count) count.textContent = String(shown);
    document.getElementById('covers')?.classList.toggle('is-filtered', tag !== 'all');
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === tag)));
  };

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const tag = chip.dataset.filter || 'all';
      const doc = document as any;
      if (doc.startViewTransition && !reduced) doc.startViewTransition(() => applyFilter(tag));
      else applyFilter(tag);
    })
  );

  // ---- work: a cover leans toward the pointer
  if (!reduced && window.matchMedia('(hover: hover)').matches) {
    for (const cover of covers) {
      const art = cover.querySelector<HTMLElement>('.cover-art');
      if (!art) continue;
      cover.addEventListener('pointermove', (event) => {
        const rect = art.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        art.style.setProperty('--ry', `${(x * 9).toFixed(2)}deg`);
        art.style.setProperty('--rx', `${(-y * 9).toFixed(2)}deg`);
        art.style.setProperty('--gx', `${((x + 0.5) * 100).toFixed(1)}%`);
        art.style.setProperty('--gy', `${((y + 0.5) * 100).toFixed(1)}%`);
      });
      cover.addEventListener('pointerleave', () => {
        art.style.setProperty('--ry', '0deg');
        art.style.setProperty('--rx', '0deg');
      });
    }
  }

  // ---- work: the credit sheet
  const dialog = document.getElementById('credit-dialog') as HTMLDialogElement | null;
  const data = JSON.parse(document.getElementById('credit-data')?.textContent || '{}');
  const $ = (id: string) => document.getElementById(id)!;

  const openCredit = (id: string) => {
    const credit = data[id];
    if (!credit || !dialog) return;
    ($('credit-art') as HTMLImageElement).src = credit.thumb || '';
    ($('credit-art') as HTMLImageElement).alt = `Cover art for ${credit.title}`;
    $('credit-title').textContent = credit.title;
    $('credit-publisher').textContent = [credit.publisher, ...(credit.producers || [])]
      .filter((v, i, all) => v && all.indexOf(v) === i)
      .join(' · ');
    $('credit-roles').textContent = credit.roles.join(', ');
    const lines = [];
    if (credit.genre) lines.push(credit.genre);
    if (credit.stars?.length) lines.push(`With ${credit.stars.join(', ')}`);
    $('credit-stars').textContent = lines.join('. ');
    $('credit-stars').hidden = lines.length === 0;

    const awards = $('credit-awards');
    awards.replaceChildren();
    // a badge that an award line already spells out is not said twice
    const badges = credit.badges.filter(
      (badge: string) => !credit.awards.some((award: string) => award.startsWith(badge.split(' ')[0]))
    );
    for (const fact of [...badges, ...credit.awards, ...(credit.highlights || [])]) {
      const li = document.createElement('li');
      li.textContent = fact;
      awards.append(li);
    }
    awards.hidden = awards.children.length === 0;

    const links = $('credit-links');
    links.replaceChildren();
    const named: [string, string | null][] = [
      ['Apple Podcasts', credit.links.apple],
      ['Spotify', credit.links.spotify],
      ['Official page', credit.links.official],
    ];
    for (const [label, href] of named) {
      if (!href) continue;
      const a = document.createElement('a');
      a.href = href;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = label;
      links.append(a);
    }
    links.hidden = links.children.length === 0;
    heldAt = window.scrollY;
    const root = document.documentElement;
    root.style.setProperty('--sheet-hold', `${-heldAt}px`);
    root.classList.add('is-sheet-open');
    dialog.showModal();
  };

  // the page stays pinned under the sheet and comes back exactly where it was
  let heldAt = 0;
  dialog?.addEventListener('close', () => {
    const root = document.documentElement;
    root.classList.remove('is-sheet-open');
    root.style.removeProperty('--sheet-hold');
    window.scrollTo({ top: heldAt, behavior: 'instant' });
  });

  covers.forEach((cover) => cover.addEventListener('click', () => openCredit(cover.dataset.id || '')));
  dialog?.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  // On a phone the card can be pulled down from its top and thrown away.
  // It follows the finger, tilting toward whichever side the hand drifts;
  // let go far enough or fast enough and it falls off the screen, short
  // of that and it settles back.
  if (dialog) {
    let startX = 0;
    let startY = 0;
    let lastY = 0;
    let lastT = 0;
    let speed = 0;
    let dragging = false;
    let armed = false;
    const place = (dx: number, dy: number) => {
      dialog.style.transform = `translate(${dx * 0.35}px, ${dy}px) rotate(${dx * 0.04 + dy * 0.01 * Math.sign(dx || 1)}deg)`;
      dialog.style.opacity = String(Math.max(0.4, 1 - dy / 900));
    };
    const reset = () => {
      dialog.style.transition = '';
      dialog.style.transform = '';
      dialog.style.opacity = '';
    };
    dialog.addEventListener('close', reset);
    dialog.addEventListener('touchstart', (event) => {
      if (event.touches.length !== 1) return;
      const touch = event.touches[0];
      const top = dialog.getBoundingClientRect().top;
      // only from the top of the card, and only while it is scrolled to its top
      armed = dialog.scrollTop <= 0 && touch.clientY - top < Math.min(window.innerHeight * 0.45, 360);
      dragging = false;
      startX = touch.clientX;
      startY = lastY = touch.clientY;
      lastT = event.timeStamp;
      speed = 0;
    }, { passive: true });
    dialog.addEventListener('touchmove', (event) => {
      if (!armed) return;
      const touch = event.touches[0];
      const dy = touch.clientY - startY;
      const dx = touch.clientX - startX;
      if (!dragging) {
        if (dy < 6 || Math.abs(dx) > dy) {
          if (dy < -6 || Math.abs(dx) > 12) armed = false;
          return;
        }
        dragging = true;
        dialog.style.transition = 'none';
      }
      if (event.cancelable) event.preventDefault();
      const dt = Math.max(1, event.timeStamp - lastT);
      speed = speed * 0.6 + ((touch.clientY - lastY) / dt) * 0.4;
      lastY = touch.clientY;
      lastT = event.timeStamp;
      place(dx, Math.max(0, dy));
    }, { passive: false });
    const release = (event: TouchEvent) => {
      if (!dragging) return;
      dragging = false;
      armed = false;
      const touch = event.changedTouches[0];
      const dy = touch.clientY - startY;
      const dx = touch.clientX - startX;
      if (dy > 120 || speed > 0.6) {
        // thrown: it carries on down and away, turning as it goes
        const lean = dx === 0 ? 1 : Math.sign(dx);
        dialog.style.transition = 'transform 420ms cubic-bezier(0.4, 0, 1, 1), opacity 420ms ease-in';
        dialog.style.transform = `translate(${dx * 0.35 + lean * 90}px, ${window.innerHeight}px) rotate(${lean * 18}deg)`;
        dialog.style.opacity = '0';
        window.setTimeout(() => dialog.close(), 400);
      } else {
        dialog.style.transition = 'transform 360ms var(--ease-drift), opacity 360ms var(--ease-drift)';
        dialog.style.transform = '';
        dialog.style.opacity = '';
      }
    };
    dialog.addEventListener('touchend', release);
    dialog.addEventListener('touchcancel', release);
  }

  // ---- work: on a phone, the second half of the covers on request
  const coversGrid = document.getElementById('covers');
  const coversToggle = document.getElementById('covers-toggle');
  coversToggle?.addEventListener('click', () => {
    const open = coversGrid?.classList.toggle('is-open') ?? false;
    coversToggle.setAttribute('aria-expanded', String(open));
    coversToggle.textContent = open ? 'Fewer titles' : 'More titles';
  });

  // ---- listen: on a phone, the second half of the reels on request
  const reelsGrid = document.getElementById('reels');
  const reelsToggle = document.getElementById('reels-toggle');
  reelsToggle?.addEventListener('click', () => {
    const open = reelsGrid?.classList.toggle('is-open') ?? false;
    reelsToggle.setAttribute('aria-expanded', String(open));
    reelsToggle.textContent = open ? 'Fewer reels' : 'More reels';
    // the ones just shown have not been seen by the reveal yet
    if (open) reelsGrid?.querySelectorAll('.reel-extra').forEach((reel) => reel.classList.add('is-seen'));
  });

  // ---- games: the reels. A hand of titles shows at a time. Every column
  // spins at once, art streaming down from the top, then the columns brake
  // and lock one after another from left to right. A soft light runs
  // across the row when the last one lands. The Re-Spin button deals
  // another hand from a shuffled deck, so every title comes round.
  const gamesGrid = document.getElementById('games-grid');
  const spinButton = document.getElementById('games-spin') as HTMLButtonElement | null;
  if (gamesGrid) {
    const allGames = [...gamesGrid.querySelectorAll<HTMLElement>('.game')];
    // five reels of three on wide screens, three reels of three on phones
    const narrow = window.matchMedia('(max-width: 720px)');
    const handSize = () => (narrow.matches ? 9 : 15);
    // Keep exactly one full hand on show. If the window changes size, the
    // grid trims down or tops back up, so there is never a short row.
    const fitHand = () => {
      const size = handSize();
      const showing = allGames.filter((cell) => cell.classList.contains('is-on'));
      showing.slice(size).forEach((cell) => cell.classList.remove('is-on'));
      if (showing.length < size) {
        allGames
          .filter((cell) => !cell.classList.contains('is-on'))
          .slice(0, size - showing.length)
          .forEach((cell) => {
            cell.classList.add('is-on');
            cell.querySelector('img')?.setAttribute('loading', 'eager');
          });
      }
    };
    fitHand();
    narrow.addEventListener('change', fitHand);
    const canSpin = !reduced && typeof gamesGrid.animate === 'function';
    const pool: string[] = JSON.parse(gamesGrid.dataset.reelPool || '[]');
    const artOf = (cell: HTMLElement) => cell.querySelector<HTMLImageElement>('.game-art img')?.getAttribute('src') || '';
    let spinning = false;

    // `leaving` is the art each window showed before this spin, so the old
    // symbols are seen rolling away. The spin always runs at its own pace:
    // the scroll never hurries it.
    const spin = (leaving: string[]) => {
      const cells = allGames.filter((cell) => cell.classList.contains('is-on'));
      const lefts = [...new Set(cells.map((cell) => Math.round(cell.offsetLeft)))].sort((a, b) => a - b);
      const anims: Animation[] = [];
      const tails: HTMLElement[] = [];
      let length = 0;
      const lastStop = 820 + (lefts.length - 1) * 300;
      const phone = narrow.matches;

      cells.forEach((cell, n) => {
        const art = cell.querySelector<HTMLElement>('.game-art');
        const face = art?.firstElementChild as HTMLElement | null;
        if (!art || !face) return;
        const col = lefts.indexOf(Math.round(cell.offsetLeft));
        const height = art.clientHeight;
        const count = 7 + col * 3; // later reels spin longer, so they show more symbols
        const duration = 820 + col * 300;

        // the strip of passing symbols hangs below the real art and rides with it
        const tail = document.createElement('span');
        tail.className = 'reel-tail';
        for (let k = 0; k < count; k++) {
          const symbol = new Image();
          symbol.alt = '';
          const last = k === count - 1;
          symbol.src = (last && leaving[n]) || pool[(n * 5 + k * 3) % pool.length] || '';
          tail.append(symbol);
        }
        art.append(tail);
        tails.push(tail);

        // fast and steady, then the brake, a small overshoot, and the lock.
        // A phone drops the motion blur: redrawing a blurred strip every
        // frame is what made the lock ring and the pop arrive late there.
        const blur = (px: number) => (phone ? {} : { filter: `blur(${px}px)` });
        const frames: Keyframe[] = [
          { translate: `0 ${-count * height}px`, ...blur(0), easing: 'ease-in' },
          { translate: `0 ${-(count - 1.2) * height}px`, ...blur(3), offset: 0.1, easing: 'linear' },
          { translate: `0 ${-1.7 * height}px`, ...blur(2.5), offset: 0.58, easing: 'cubic-bezier(0.12, 0.72, 0.3, 1)' },
          { translate: `0 ${0.09 * height}px`, ...blur(0), offset: 0.88, easing: 'ease-in-out' },
          { translate: '0 0', ...blur(0) },
        ];
        for (const part of [face, tail]) {
          anims.push(part.animate(frames, { duration, fill: 'backwards' }));
        }
        // the lock: a quick ring of light on the cell, and the title appears.
        // On a phone the ring is a layer of its own that only fades, which
        // the phone can run without redrawing the cell.
        if (phone) {
          const ring = document.createElement('span');
          ring.className = 'reel-ring';
          cell.append(ring);
          tails.push(ring);
          anims.push(
            ring.animate([{ opacity: 0 }, { opacity: 1, offset: 0.18 }, { opacity: 0 }], {
              duration: 620,
              delay: duration * 0.86,
              fill: 'both',
            })
          );
        } else {
          anims.push(
            art.animate(
              [
                { boxShadow: '0 0 0 0 rgba(233, 201, 141, 0)' },
                { boxShadow: '0 0 0 2px rgba(233, 201, 141, 0.95), 0 0 26px 2px rgba(233, 201, 141, 0.45)', offset: 0.18 },
                { boxShadow: '0 0 0 0 rgba(233, 201, 141, 0)' },
              ],
              { duration: 620, delay: duration * 0.86 }
            )
          );
        }
        cell.querySelectorAll('h3, p').forEach((line) => {
          anims.push(
            line.animate(
              [
                { opacity: 0, translate: '0 0.4rem' },
                { opacity: 1, translate: '0 0' },
              ],
              { duration: 380, delay: duration * 0.9, fill: 'backwards', easing: 'ease-out' }
            )
          );
        });
        // the payoff: one soft pulse runs left to right after the last reel
        anims.push(
          art.animate([{ scale: '1' }, { scale: '1.045' }, { scale: '1' }], {
            duration: 460,
            delay: lastStop + 140 + col * 80,
            easing: 'ease-out',
          })
        );
        length = Math.max(length, lastStop + 140 + col * 80 + 460);
      });

      spinning = true;
      spinButton?.setAttribute('aria-disabled', 'true');
      gamesGrid.classList.add('is-spun');
      const finished = () => {
        tails.forEach((tail) => tail.remove());
        spinning = false;
        spinButton?.removeAttribute('aria-disabled');
      };
      Promise.allSettled(anims.map((anim) => anim.finished)).then(finished);
    };

    // the deck: every title, shuffled, dealt fifteen at a time
    let deck: HTMLElement[] = [];
    const deal = () => {
      const showing = allGames.filter((cell) => cell.classList.contains('is-on'));
      const hand: HTMLElement[] = [];
      while (hand.length < handSize()) {
        if (deck.length === 0) {
          deck = allGames.filter((cell) => !showing.includes(cell) && !hand.includes(cell));
          for (let i = deck.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [deck[i], deck[j]] = [deck[j], deck[i]];
          }
          if (deck.length === 0) break;
        }
        hand.push(deck.pop() as HTMLElement);
      }
      const leaving = showing.map(artOf);
      showing.forEach((cell) => cell.classList.remove('is-on'));
      hand.forEach((cell) => {
        cell.classList.add('is-on');
        cell.querySelector('img')?.setAttribute('loading', 'eager');
      });
      return leaving;
    };

    spinButton?.addEventListener('click', () => {
      if (spinning) return;
      const leaving = deal();
      if (canSpin) spin(leaving);
      else gamesGrid.classList.add('is-spun');
    });

    if (!canSpin) {
      gamesGrid.classList.add('is-spun');
    } else {
      // Watch the grid's position directly. The passing symbols are fetched
      // while it is still a couple of screens away, and the first spin starts
      // once the top row is properly on screen, so it is seen from the start.
      let warmed = false;
      const watch = () => {
        const rect = gamesGrid.getBoundingClientRect();
        const vh = window.innerHeight;
        if (!warmed && rect.top < vh * 3) {
          warmed = true;
          pool.forEach((src) => (new Image().src = src));
        }
        const start = () => {
          window.removeEventListener('scroll', watch);
          clearTimeout(settle);
          // the reels rest on their art until now; the first spin rolls that
          // art away and lands back on the same hand
          if (!spinning && !gamesGrid.classList.contains('is-spun')) {
            spin(allGames.filter((cell) => cell.classList.contains('is-on')).map(artOf));
          }
        };
        if (!narrow.matches) {
          if (rect.top < vh * 0.8 && rect.bottom > 0) start();
          return;
        }
        // On a phone a thumb flick carries the page a long way, and a spin
        // that starts at the first sight of the grid is over before the
        // grid is on screen. So the spin waits until most of the grid is
        // in view and the scroll has slowed, or until the scroll comes to
        // rest with the grid showing.
        const seen = (Math.min(vh, rect.bottom) - Math.max(0, rect.top)) / rect.height;
        const now = performance.now();
        const speed = Math.abs(window.scrollY - lastY) / Math.max(1, now - lastT);
        lastY = window.scrollY;
        lastT = now;
        if (seen >= 0.7 && speed < 0.9) return start();
        clearTimeout(settle);
        if (seen > 0.25) settle = window.setTimeout(start, 160);
      };
      let settle = 0;
      let lastY = window.scrollY;
      let lastT = performance.now();
      window.addEventListener('scroll', watch, { passive: true });
      watch();
    }
  }

  // ---- reels: nothing loads from the video host until asked
  document.querySelectorAll<HTMLButtonElement>('.reel-frame').forEach((frame) => {
    frame.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0`;
      iframe.title = frame.getAttribute('aria-label') || 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'reel-frame reel-live';
      frame.replaceWith(iframe);
    });
  });

  // ---- the lab: the shapes, their voices, and gravity on request.
  // Nothing loads until the room is nearly on screen.
  const room = document.getElementById('room');
  if (room && 'IntersectionObserver' in window) {
    // Exit: the page eases back up until the room is only the lower part
    // of the screen, far enough out that the header lets go
    document.getElementById('room-exit')?.addEventListener('click', () => {
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const top = room.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.65;
      window.scrollTo({ top: Math.max(0, top), behavior: still ? 'auto' : 'smooth' });
    });
    const floorButton = document.getElementById('room-floor');
    let falling = false;

    const boot = async () => {
      const [{ shouldAnimate, startEnvironment }, { engine }] = await Promise.all([
        import('../scripts/environment.js'),
        import('../scripts/audio-engine.js'),
      ]);

      // The room always sounds. The browser keeps audio asleep until the
      // visitor's first touch inside the room, and that touch wakes it.
      engine.setOn(true);
      // Which touch counts as the one that may start sound differs between
      // browsers: some take the press, iPhones and iPads want the release.
      // So every kind of touch in the room tries, until one has worked.
      const wakers = ['pointerdown', 'pointerup', 'touchend', 'click', 'keydown'];
      const tryWake = () => {
        engine.wake();
        if (engine.awake()) wakers.forEach((type) => room.removeEventListener(type, tryWake, true));
      };
      wakers.forEach((type) => room.addEventListener(type, tryWake, true));

      // Leave the lab and its sound goes with a soft fade: scrolled away,
      // or the tab or app put behind something else. Come back and it is
      // there again.
      let labSeen = true;
      const hushIfAway = () => engine.hush(!labSeen || document.hidden);
      new IntersectionObserver(
        (entries) => {
          labSeen = entries[entries.length - 1].intersectionRatio > 0.2;
          hushIfAway();
        },
        { threshold: [0, 0.2, 0.4] }
      ).observe(room);
      document.addEventListener('visibilitychange', hushIfAway);

      floorButton?.addEventListener('click', () => {
        falling = !falling;
        floorButton.setAttribute('aria-pressed', String(falling));
        floorButton.textContent = falling ? 'Let them float' : 'Let them fall';
      });

      if (shouldAnimate()) startEnvironment(room, { room: true, pile: () => falling });
      else room.classList.add('is-still');
    };

    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        near.disconnect();
        boot();
      },
      { rootMargin: '60% 0px 60% 0px' }
    );
    near.observe(room);
  }

  // ---- contact: the scene. When the band has come up onto the screen
  // the whole of it plays once on its own clock: the note is typed, the
  // signature appears, the button arrives, and it stays finished. The band
  // is held for a short stretch so there is time to watch it, and then the
  // lab comes up underneath.
  const contactScroll = document.getElementById('contact-scroll');
  if (contactScroll) {
    const stageEl = contactScroll.querySelector<HTMLElement>('.contact-stage');
    const letters = [...contactScroll.querySelectorAll<HTMLElement>('.tw-ch')];
    if (stageEl && letters.length) {
      if (reduced) {
        letters.forEach((letter) => letter.classList.add('on'));
        stageEl.style.setProperty('--drift', '0.5');
        stageEl.style.setProperty('--cta', '1');
        stageEl.classList.add('is-typed', 'is-done');
      } else {
        const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
        const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
        let shown = 0;
        let begun = false;

        const show = (count: number) => {
          if (count === shown) return;
          const from = Math.min(count, shown);
          const to = Math.max(count, shown);
          for (let i = from; i < to; i++) letters[i].classList.toggle('on', i < count);
          letters[shown - 1]?.classList.remove('caret');
          if (count > 0 && count < letters.length) letters[count - 1].classList.add('caret');
          shown = count;
        };

        // The whole scene, once, on its own clock: the note is typed at a
        // steady pace while the portrait drifts, then the signature, then
        // the button. Nothing in it waits on the scroll.
        const LETTER_MS = 24;
        const play = async () => {
          const writing = letters.length * LETTER_MS;
          const started = performance.now();
          const drift = () => {
            const along = clamp01((performance.now() - started) / (writing + 900));
            stageEl.style.setProperty('--drift', (1 - Math.pow(1 - along, 2)).toFixed(4));
            if (along < 1) requestAnimationFrame(drift);
          };
          requestAnimationFrame(drift);
          for (let count = 1; count <= letters.length; count++) {
            show(count);
            // a breath at the end of a sentence, as a hand would take
            const ch = letters[count - 1].textContent || '';
            await wait(ch === '.' || ch === ',' ? LETTER_MS * 6 : LETTER_MS);
          }
          await wait(200);
          stageEl.classList.add('is-typed');
          await wait(300);
          const landing = performance.now();
          const arrive = () => {
            const along = clamp01((performance.now() - landing) / 800);
            stageEl.style.setProperty('--cta', (1 - Math.pow(1 - along, 3)).toFixed(3));
            if (along < 1) requestAnimationFrame(arrive);
            else stageEl.classList.add('is-done');
          };
          requestAnimationFrame(arrive);
        };

        // it begins when the band has come up to fill most of the screen
        const check = () => {
          if (begun) return;
          if (contactScroll.getBoundingClientRect().top > window.innerHeight * 0.35) return;
          begun = true;
          window.removeEventListener('scroll', check);
          play();
        };
        stageEl.style.setProperty('--drift', '0');
        window.addEventListener('scroll', check, { passive: true });
        check();
      }
    }
  }

  // ---- contact: copy the address
  const copy = document.getElementById('copy-email');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.email || '');
      copy.textContent = 'Copied';
    } catch {
      copy.textContent = copy.dataset.email || '';
    }
    setTimeout(() => (copy.textContent = 'Copy the address'), 2400);
  });
</script>
