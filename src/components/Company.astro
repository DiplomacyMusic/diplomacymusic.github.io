---
import fs from 'node:fs';

// The publishers and studios. Four lead marks stand still in a row of
// their own; the rest slide beneath them as one line. Each logo is a real
// brand SVG rendered through a mask so the whole wall sits in one quiet
// tone. Every mark gets the same visual area, not the same height: a
// long wordmark runs wide and low, a round badge sits compact, and they
// read as equals. `weight` nudges the few that still look light or heavy.

// The lead row, in this order. A phone shows three: DC steps down into
// the sliding line there.
const leadNames = [
  { id: 'audible', name: 'Audible', weight: 1 },
  { id: 'spotify', name: 'Spotify', weight: 1 },
  { id: 'dc', name: 'DC', weight: 0.82, only: 'wide' },
  { id: 'marvel', name: 'Marvel', weight: 0.95 },
];

// The sliding line. It is shuffled on every visit, except that the marks
// flagged `front` sit in the middle of the line, which is the part on
// screen first, and the marks flagged `back` always come last. The first
// entry must show on every screen: the swipe measures the line from it.
const names = [
  { id: 'startrek', name: 'Star Trek', weight: 1.05 },
  { id: 'sega', name: 'Sega', weight: 0.95 },
  { id: 'broadwayvideo', name: 'Broadway Video', weight: 1 },
  { id: 'gatorade', name: 'Gatorade', weight: 1.05, front: true },
  { id: 'lyft', name: 'Lyft', weight: 0.85, front: true },
  { id: 'batman', name: 'Batman', weight: 1 },
  // two marks cut from pictures, so they are images with their own proportions
  { id: 'hobbit', name: 'The Hobbit', weight: 1.1, file: 'hobbit.png', ratio: 900 / 289 },
  { id: 'monkeypaw', name: 'Monkeypaw Productions', weight: 1.15, file: 'monkeypaw.png', ratio: 1120 / 352 },
  { id: 'jamesbond', name: 'James Bond 007', weight: 1 },
  { id: 'nintendo', name: 'Nintendo', weight: 1 },
  { id: 'ubisoft', name: 'Ubisoft', weight: 0.82 },
  { id: 'redbull', name: 'Red Bull', weight: 1 },
  { id: 'mcdonalds', name: "McDonald's", weight: 0.8 },
  { id: 'kelloggs', name: "Kellogg's", weight: 1.15 },
  { id: 'secret', name: 'Secret', weight: 1.15 },
  { id: 'exelon', name: 'Exelon', weight: 1.05 },
  { id: 'bbdo', name: 'BBDO', weight: 0.9 },
  { id: 'dc', name: 'DC', weight: 0.82, only: 'phone' },
  { id: 'maytag', name: 'Maytag', weight: 1, back: true },
  { id: 'siriusxm', name: 'SiriusXM', weight: 1.05, back: true },
  { id: 'whirlpool', name: 'Whirlpool', weight: 1.2, back: true },
];

const measure = (logo) => {
  const file = logo.file || `${logo.id}.svg`;
  if (logo.ratio) return { ...logo, file, width: Math.sqrt(logo.ratio) * logo.weight };
  const svg = fs.readFileSync(`public/brand/logos/${file}`, 'utf8');
  let ratio = 3;
  const viewBox = svg.match(/viewBox="([^"]+)"/);
  if (viewBox) {
    const parts = viewBox[1].trim().split(/[\s,]+/).map(Number);
    if (parts.length === 4 && parts[3] > 0) ratio = parts[2] / parts[3];
  } else {
    const w = svg.match(/<svg[^>]*\swidth="([\d.]+)/);
    const h = svg.match(/<svg[^>]*\sheight="([\d.]+)/);
    if (w && h && Number(h[1]) > 0) ratio = Number(w[1]) / Number(h[1]);
  }
  // equal area: width grows with the square root of the proportions
  const width = Math.sqrt(ratio) * logo.weight;
  return { ...logo, file, ratio, width };
};
const lead = leadNames.map(measure);
const logos = names.map(measure);
const only = (logo) => (logo.only ? `company-${logo.only}-only` : '');
---

<div class="company">
  <!-- the lead row: a few marks that stand still -->
  <ul class="company-lead" data-reveal>
    {lead.map((logo) => (
      <li class={only(logo) || undefined}>
        <span
          class="company-logo"
          role="img"
          aria-label={logo.name}
          style={`--logo: url('/brand/logos/${logo.file}'); width: calc(var(--logo-unit) * ${logo.width.toFixed(3)}); aspect-ratio: ${logo.ratio.toFixed(3)};`}
        />
      </li>
    ))}
  </ul>
  <!-- one line of marks that slides sideways as the page scrolls. The
       set repeats so the line is always full; only the first set is read
       out, the repeats are decoration -->
  <div class="company-rail" data-reveal>
    <ul class="company-track" data-depth="1.7" data-axis="x" data-rush="10">
      {[0, 1, 2].map((round) =>
        logos.map((logo, i) => (
          <li
            class={[round === 1 ? '' : 'company-repeat', only(logo)].filter(Boolean).join(' ') || undefined}
            aria-hidden={round === 1 ? undefined : 'true'}
            data-round={round}
            data-logo={i}
            data-back={logo.back ? '' : undefined}
            data-front={logo.front ? '' : undefined}
          >
            <span
              class="company-logo"
              role={round === 1 ? 'img' : undefined}
              aria-label={round === 1 ? logo.name : undefined}
              style={`--logo: url('/brand/logos/${logo.file}'); width: calc(var(--logo-unit) * ${logo.width.toFixed(3)}); aspect-ratio: ${logo.ratio.toFixed(3)};`}
            />
          </li>
        ))
      )}
    </ul>
    <!-- a new order on every visit, the same in each repeat of the set, so
         a different handful of marks sits in the middle of the line each
         time. The marks flagged for the front stay in that middle, and
         the marks flagged for the back keep their place at the end.
         It runs in place, before the line is first drawn. -->
    <script is:inline>
      (() => {
        const items = [...document.currentScript.previousElementSibling.children];
        const count = items.length / 3;
        const set = items.slice(0, count);
        const pick = (test) => set.filter(test).map((item) => Number(item.dataset.logo));
        const shuffle = (list) => {
          for (let i = list.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [list[i], list[j]] = [list[j], list[i]];
          }
          return list;
        };
        const front = shuffle(pick((item) => 'front' in item.dataset));
        const back = pick((item) => 'back' in item.dataset);
        const rest = shuffle(pick((item) => !('front' in item.dataset) && !('back' in item.dataset)));
        // the line is centred, so the middle of the set is what shows first
        const middle = Math.max(0, Math.min(rest.length, Math.round(count / 2 - front.length / 2)));
        const place = {};
        [...rest.slice(0, middle), ...front, ...rest.slice(middle), ...back].forEach((logo, at) => (place[logo] = at));
        for (const item of items) {
          item.style.order = String(Number(item.dataset.round) * count + place[Number(item.dataset.logo)]);
        }
      })();
    </script>
  </div>
</div>

<script>
  // On a touch screen the line can also be pulled sideways with a finger.
  // The rail only ever claims sideways movement (touch-action: pan-y in the
  // styles), so an up or down swipe that starts on the logos still scrolls
  // the page: the browser takes it and this code is told to let go.
  // The pull is kept on the track's own `translate`, apart from the
  // `transform` the scroll uses, and it wraps by one set of logos, so the
  // line never runs out in either direction.
  const rail = document.querySelector<HTMLElement>('.company-rail');
  const track = rail?.querySelector<HTMLElement>('.company-track');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rail && track && !still) {
    let offset = 0;
    let lastX = 0;
    let lastT = 0;
    let speed = 0; // px per ms
    let held: number | null = null;
    let coast = 0;

    const setWidth = () => {
      // the sets are laid out one after another, so the distance between the
      // same logo in two sets is the width of one set
      const a = track.querySelector<HTMLElement>('li[data-round="0"][data-logo="0"]');
      const b = track.querySelector<HTMLElement>('li[data-round="1"][data-logo="0"]');
      if (!a || !b) return 0;
      return Math.abs(b.getBoundingClientRect().left - a.getBoundingClientRect().left);
    };

    const place = () => {
      const set = setWidth();
      if (set > 0) {
        if (offset > set / 2) offset -= set;
        if (offset < -set / 2) offset += set;
      }
      track.style.translate = `${offset.toFixed(1)}px 0`;
    };

    const glide = () => {
      speed *= 0.94;
      if (Math.abs(speed) < 0.02) return;
      offset += speed * 16;
      place();
      coast = requestAnimationFrame(glide);
    };

    rail.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      cancelAnimationFrame(coast);
      held = event.pointerId;
      lastX = event.clientX;
      lastT = event.timeStamp;
      speed = 0;
    });

    rail.addEventListener('pointermove', (event) => {
      if (event.pointerId !== held) return;
      const dx = event.clientX - lastX;
      const dt = Math.max(1, event.timeStamp - lastT);
      offset += dx;
      speed = 0.7 * speed + 0.3 * (dx / dt);
      lastX = event.clientX;
      lastT = event.timeStamp;
      place();
    });

    const release = (event: PointerEvent) => {
      if (event.pointerId !== held) return;
      held = null;
      // let go by the finger: coast to a stop. Taken by the browser for a
      // page scroll: just stop where it is.
      if (event.type === 'pointerup') coast = requestAnimationFrame(glide);
    };
    rail.addEventListener('pointerup', release);
    rail.addEventListener('pointercancel', release);
  }
</script>
