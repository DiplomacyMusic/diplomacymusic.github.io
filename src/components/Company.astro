---
import fs from 'node:fs';

// The publishers and studios, as one sliding line. Each logo is a real
// brand SVG rendered through a mask so the whole wall sits in one quiet
// tone. Every mark gets the same visual area, not the same height: a
// long wordmark runs wide and low, a round badge sits compact, and they
// read as equals. `weight` nudges the few that still look light or heavy.
const names = [
  { id: 'marvel', name: 'Marvel', weight: 0.95 },
  { id: 'spotify', name: 'Spotify', weight: 1 },
  { id: 'audible', name: 'Audible', weight: 1 },
  { id: 'startrek', name: 'Star Trek', weight: 1.05 },
  { id: 'dc', name: 'DC', weight: 0.82 },
  { id: 'amazon', name: 'Amazon', weight: 1 },
  { id: 'sega', name: 'Sega', weight: 0.95 },
  { id: 'siriusxm', name: 'SiriusXM', weight: 1.05 },
  { id: 'broadwayvideo', name: 'Broadway Video', weight: 1 },
  { id: 'mcdonalds', name: "McDonald's", weight: 0.8 },
  { id: 'maytag', name: 'Maytag', weight: 1 },
  { id: 'nintendo3ds', name: 'Nintendo 3DS', weight: 0.8 },
  { id: 'ubisoft', name: 'Ubisoft', weight: 0.82 },
  { id: 'redbull', name: 'Red Bull', weight: 1 },
  { id: 'kelloggs', name: "Kellogg's", weight: 1.15 },
  { id: 'whirlpool', name: 'Whirlpool', weight: 1.2 },
  { id: 'secret', name: 'Secret', weight: 1.15 },
  { id: 'exelon', name: 'Exelon', weight: 1.05 },
  { id: 'bbdo', name: 'BBDO', weight: 0.9 },
];

const logos = names.map((logo) => {
  const svg = fs.readFileSync(`public/brand/logos/${logo.id}.svg`, 'utf8');
  let ratio = 3;
  const viewBox = svg.match(/viewBox="([^"]+)"/);
  if (viewBox) {
    const parts = viewBox[1].trim().split(/[\s,]+/).map(Number);
    if (parts.length === 4 && parts[3] > 0) ratio = parts[2] / parts[3];
  } else {
    const w = svg.match(/<svg[^>]*\swidth="([\d.]+)/);
    const h = svg.match(/<svg[^>]*\sheight="([\d.]+)/);
    if (w && h && Number(h[1]) > 0) ratio = Number(w[1]) / Number(h[1]);
  }
  // equal area: width grows with the square root of the proportions
  const width = Math.sqrt(ratio) * logo.weight;
  return { ...logo, ratio, width };
});
---

<div class="company">
  <p class="overline" data-reveal>In good company</p>
  <!-- one line of marks that slides sideways as the page scrolls. The
       set repeats so the line is always full; only the first set is read
       out, the repeats are decoration -->
  <div class="company-rail" data-reveal>
    <ul class="company-track" data-depth="1.7" data-axis="x">
      {[0, 1, 2].map((round) =>
        logos.map((logo, i) => (
          <li class={round === 1 ? undefined : 'company-repeat'} aria-hidden={round === 1 ? undefined : 'true'} data-round={round} data-logo={i}>
            <span
              class="company-logo"
              role={round === 1 ? 'img' : undefined}
              aria-label={round === 1 ? logo.name : undefined}
              style={`--logo: url('/brand/logos/${logo.id}.svg'); width: calc(var(--logo-unit) * ${logo.width.toFixed(3)}); aspect-ratio: ${logo.ratio.toFixed(3)};`}
            />
          </li>
        ))
      )}
    </ul>
    <!-- a new order on every visit, the same in each repeat of the set, so
         a different handful of marks sits in the middle of the line each
         time. It runs in place, before the line is first drawn. -->
    <script is:inline>
      (() => {
        const items = document.currentScript.previousElementSibling.children;
        const count = items.length / 3;
        const order = Array.from({ length: count }, (_, i) => i);
        for (let i = count - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [order[i], order[j]] = [order[j], order[i]];
        }
        for (const item of items) {
          item.style.order = String(Number(item.dataset.round) * count + order[Number(item.dataset.logo)]);
        }
      })();
    </script>
  </div>
</div>

<script>
  // On a touch screen the line can also be pulled sideways with a finger.
  // The rail only ever claims sideways movement (touch-action: pan-y in the
  // styles), so an up or down swipe that starts on the logos still scrolls
  // the page: the browser takes it and this code is told to let go.
  // The pull is kept on the track's own `translate`, apart from the
  // `transform` the scroll uses, and it wraps by one set of logos, so the
  // line never runs out in either direction.
  const rail = document.querySelector<HTMLElement>('.company-rail');
  const track = rail?.querySelector<HTMLElement>('.company-track');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rail && track && !still) {
    let offset = 0;
    let lastX = 0;
    let lastT = 0;
    let speed = 0; // px per ms
    let held: number | null = null;
    let coast = 0;

    const setWidth = () => {
      // the sets are laid out one after another, so the distance between the
      // same logo in two sets is the width of one set
      const a = track.querySelector<HTMLElement>('li[data-round="0"][data-logo="0"]');
      const b = track.querySelector<HTMLElement>('li[data-round="1"][data-logo="0"]');
      if (!a || !b) return 0;
      return Math.abs(b.getBoundingClientRect().left - a.getBoundingClientRect().left);
    };

    const place = () => {
      const set = setWidth();
      if (set > 0) {
        if (offset > set / 2) offset -= set;
        if (offset < -set / 2) offset += set;
      }
      track.style.translate = `${offset.toFixed(1)}px 0`;
    };

    const glide = () => {
      speed *= 0.94;
      if (Math.abs(speed) < 0.02) return;
      offset += speed * 16;
      place();
      coast = requestAnimationFrame(glide);
    };

    rail.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      cancelAnimationFrame(coast);
      held = event.pointerId;
      lastX = event.clientX;
      lastT = event.timeStamp;
      speed = 0;
    });

    rail.addEventListener('pointermove', (event) => {
      if (event.pointerId !== held) return;
      const dx = event.clientX - lastX;
      const dt = Math.max(1, event.timeStamp - lastT);
      offset += dx;
      speed = 0.7 * speed + 0.3 * (dx / dt);
      lastX = event.clientX;
      lastT = event.timeStamp;
      place();
    });

    const release = (event: PointerEvent) => {
      if (event.pointerId !== held) return;
      held = null;
      // let go by the finger: coast to a stop. Taken by the browser for a
      // page scroll: just stop where it is.
      if (event.type === 'pointerup') coast = requestAnimationFrame(glide);
    };
    rail.addEventListener('pointerup', release);
    rail.addEventListener('pointercancel', release);
  }
</script>
